<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Template del componente badge (lee partner_id del record en forma
         reactiva; se re-renderiza solo al cambiar el firmante). -->
    <t t-name="sign_quantidia.QuantidiaBadge">
        <i t-if="partnerId"
           class="fa align-self-center ms-1"
           t-att-class="ready ? 'fa-circle text-success' : 'fa-circle text-warning'"
           t-att-title="ready ? 'Tiene perfil Quantidia activo' : 'Sin perfil Quantidia activo'"
           role="img" aria-label="Quantidia"/>
    </t>

    <!-- Usar el componente dentro de cada fila del widget SignerX2Many. -->
    <t t-name="sign_quantidia.SignerX2Many"
       t-inherit="sign.SignerX2Many"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_field_wrap')]" position="inside">
            <QuantidiaBadge record="record"/>
        </xpath>
    </t>

    <t t-name="sign_quantidia.AdhocSignerX2Many">
        <div class="d-flex gap-2 mb-2 d-contents o_cell o_wrap_label flex-grow-1 flex-sm-grow-0 w-100 text-break text-900"
             t-foreach="list.records" t-as="record" t-key="record.id">
            <div class="d-flex flex-row">
                <div t-if="shouldShowOrder" class="d-flex align-items-center gap-1 me-1"
                     t-att-class="{ 'small': env.isSmall }">
                    <span class="o_signer_one2many_mail_sent_order" t-out="record.data.mail_sent_order"/>
                    <button type="button" class="btn btn-link btn-sm p-0"
                            title="Subir firmante" aria-label="Subir firmante"
                            t-att-disabled="record_index === 0"
                            t-on-click="() => this.moveSigner(record, -1)">
                        <i class="fa fa-arrow-up"/>
                    </button>
                    <button type="button" class="btn btn-link btn-sm p-0"
                            title="Bajar firmante" aria-label="Bajar firmante"
                            t-att-disabled="record_index === list.records.length - 1"
                            t-on-click="() => this.moveSigner(record, 1)">
                        <i class="fa fa-arrow-down"/>
                    </button>
                </div>
                <t t-set="labelId" t-value="record.id + partnerIdFieldInfo.name"/>
                <label t-att-for="labelId" class="o_form_label">Firmante</label>
            </div>
            <div class="o_field_wrap">
                <Many2OneField id="labelId" name="partnerIdFieldInfo.name" record="record"
                               t-props="partnerIdFieldInfo.additionalProps"/>
            </div>
        </div>
        <button type="button" class="btn btn-link p-0 mt-1" t-on-click="addSigner">
            <i class="fa fa-plus me-1"/>Agregar firmante
        </button>
    </t>

</templates>
