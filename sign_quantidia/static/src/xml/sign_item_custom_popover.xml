<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- El marcador "Firma digital Quantidia" nunca es obligatorio (el
         servidor lo normaliza a required=False): ocultar el toggle evita que
         el editor lo marque y vea como el check "no se guarda". -->
    <t t-name="sign_quantidia.SignItemCustomPopoverQuantidiaExtension"
       t-inherit="sign.SignItemCustomPopover"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('form-check')][input[@id='o_sign_required_field']]" position="attributes">
            <attribute name="t-if">props.type !== 'quantidia_signature'</attribute>
        </xpath>
    </t>
</templates>
