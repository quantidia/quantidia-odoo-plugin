<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lista -->
    <record id="quantidia_signer_view_tree" model="ir.ui.view">
        <field name="name">quantidia.signer.tree</field>
        <field name="model">quantidia.signer</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="username"/>
                <field name="email"/>
                <field name="given_name"/>
                <field name="family_name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="quantidia_signer_view_form" model="ir.ui.view">
        <field name="name">quantidia.signer.form</field>
        <field name="model">quantidia.signer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_partner" type="object"
                                string="Ver partner" class="oe_stat_button" icon="fa-user"
                                invisible="not partner_id"/>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="given_name" string="Firmante Quantidia"/>
                        <h1><field name="name_complete" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Identidad (mandatorio)">
                            <field name="given_name"/>
                            <field name="family_name"/>
                            <field name="username"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <group string="Asociacion (partner)">
                        <group>
                            <field name="partner_id" options="{'no_create': True}"
                                   domain="[('is_company', '=', False)]"
                                   readonly="id"
                                   help="Asigna un partner persona al crear, o dejalo vacio para crearlo automaticamente. Una vez creado, no se puede cambiar."/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Busqueda -->
    <record id="quantidia_signer_view_search" model="ir.ui.view">
        <field name="name">quantidia.signer.search</field>
        <field name="model">quantidia.signer</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="email"/>
                <field name="given_name"/>
                <field name="family_name"/>
                <filter name="filter_archived" string="Archivados" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Accion -->
    <record id="quantidia_signer_action" model="ir.actions.act_window">
        <field name="name">Firmantes Quantidia</field>
        <field name="res_model">quantidia.signer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Agregar un firmante Quantidia</p>
            <p>Cada firmante es un partner dado de alta para firma digital con Quantidia.</p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="quantidia_signer_menu"
              name="Firmantes"
              parent="sign_quantidia.quantidia_root_menu"
              action="quantidia_signer_action"
              sequence="20"/>
</odoo>
